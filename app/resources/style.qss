/* ============================================================================
   Voz a Texto — sistema visual
   ----------------------------------------------------------------------------
   Basado en la Guía de Diseño de marca (Jose Luis Macedo — Infographic
   System), variante oscura: negro cálido + acento dorado con gradientes.
   QSS no soporta variables CSS, así que se deja documentado aquí:

   Canvas / fondo app ... #0D0D0D   Texto headings (text-1) ... #FFFFFF
   Sidebar .............. #0A0A0A   Texto body (text-2) ........ rgba(255,255,255,.75)
   Card ................. #1A1A1A   Texto muted (text-3) ....... rgba(255,255,255,.45)
   Card 2 (alternas) .... #2E2E2E   Texto muy tenue (text-4) ... #7A7A7A
   Borde ................ rgba(255,255,255,.07)

   Marca (idénticos en todo el sistema):
   Gold ................. #C9962A     Gold claro ... #F0C84A     Gold oscuro ... #8C6518
   g-accent (gradiente) . linear-gradient(148deg, #E0AC35 → #8C6518)
   g-dark (gradiente) ... linear-gradient(148deg, #1A1210 → #0C0806)

   Semántico:
   Peligro .............. #C03030 (bg rgba(180,40,40,.12))
   Éxito ................ #2FA96A

   Tipografía: DM Sans (embebida, ver app/main.py:_load_brand_font).
   ========================================================================= */

* {
    outline: none;
}

QWidget {
    color: rgba(255, 255, 255, 0.82);
    font-family: "DM Sans", -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: #8C6518;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #0D0D0D;
}

QLabel {
    background: transparent;
}

QToolTip {
    background-color: #1A1A1A;
    color: #f5f6f8;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 6px 8px;
}

QMenuBar {
    background-color: #0D0D0D;
    color: rgba(255, 255, 255, 0.82);
}

QMenu {
    background-color: #1A1A1A;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    margin: 1px;
}

QMenu::item:selected {
    background-color: rgba(201, 150, 42, 0.20);
    color: #F0C84A;
}

/* ---------------------------------------------------------------------------
   Tipografía / labels utilitarios
--------------------------------------------------------------------------- */

#panelTitle {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.2px;
}

#panelKicker {
    font-size: 11px;
    font-weight: 700;
    color: #C9962A;
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

#sectionTitle {
    font-size: 12px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

#hintLabel {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11.5px;
}

#errorLabel {
    color: #E15252;
    font-size: 11.5px;
}

/* ---------------------------------------------------------------------------
   Sidebar de navegación
--------------------------------------------------------------------------- */

#sidebar {
    background-color: #0A0A0A;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
}

#brandHeader {
    background-color: #0A0A0A;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

#brandTitle {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.1px;
}

#brandSubtitle {
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.3px;
}

QListWidget#sidebarList {
    background-color: transparent;
    border: none;
    padding: 10px 10px;
    outline: none;
    font-size: 13px;
}

QListWidget#sidebarList::item {
    padding: 9px 12px;
    margin-bottom: 2px;
    border-radius: 7px;
    color: rgba(255, 255, 255, 0.55);
    border-left: 3px solid transparent;
}

QListWidget#sidebarList::item:selected {
    background-color: rgba(201, 150, 42, 0.16);
    color: #ffffff;
    font-weight: 600;
    border-left: 3px solid #C9962A;
}

QListWidget#sidebarList::item:hover:!selected {
    background-color: #141414;
    color: rgba(255, 255, 255, 0.85);
}

/* ---------------------------------------------------------------------------
   Botones
--------------------------------------------------------------------------- */

QPushButton {
    background-color: #1A1A1A;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 7px 15px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
}

QPushButton:hover {
    background-color: #242424;
    border-color: rgba(255, 255, 255, 0.18);
}

QPushButton:pressed {
    background-color: #141414;
}

QPushButton:disabled {
    color: rgba(255, 255, 255, 0.25);
    background-color: #121212;
    border-color: rgba(255, 255, 255, 0.05);
}

QPushButton:focus {
    border-color: #C9962A;
}

/* Botón por defecto de un QDialogButtonBox (p.ej. Guardar) y botones marcados
   explícitamente como primarios: gradiente dorado de marca (--g-accent). */
QPushButton:default,
QPushButton[variant="primary"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #E0AC35, stop:1 #8C6518);
    border: 1px solid transparent;
    color: #ffffff;
    font-weight: 700;
}

QPushButton:default:hover,
QPushButton[variant="primary"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F0C84A, stop:1 #C9962A);
}

QPushButton:default:pressed,
QPushButton[variant="primary"]:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #C9962A, stop:1 #6B4B12);
}

QPushButton[variant="danger"] {
    background-color: transparent;
    border: 1px solid rgba(224, 72, 72, 0.35);
    color: #E15252;
}

QPushButton[variant="danger"]:hover {
    background-color: rgba(192, 48, 48, 0.14);
    border-color: #E15252;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: rgba(255, 255, 255, 0.45);
    padding: 5px 10px;
}

QPushButton[variant="ghost"]:hover {
    background-color: #171717;
    color: rgba(255, 255, 255, 0.85);
}

/* Botones insertados como cell widget en QTableWidget: necesitan fondo opaco.
   Un fondo transparente ahí produce artefactos de repintado con Qt al reciclar
   los widgets de celda (se ve texto fantasma/duplicado). */
QPushButton[variant="tableAction"] {
    background-color: #242424;
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: rgba(255, 255, 255, 0.82);
    padding: 4px 12px;
    font-size: 12px;
}

QPushButton[variant="tableAction"]:hover {
    background-color: #2E2E2E;
    border-color: rgba(255, 255, 255, 0.20);
}

/* ---------------------------------------------------------------------------
   Tarjetas (stat tiles, worker cards, filas de modelo)
--------------------------------------------------------------------------- */

#statTile, #workerCard, #modelRow {
    background-color: #1A1A1A;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}

#workerCard {
    border-left: 3px solid #C9962A;
}

#chartCard {
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
}

#statValue {
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.3px;
}

#statTitle {
    color: rgba(255, 255, 255, 0.45);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

#workerCardTitle {
    font-weight: 700;
    color: #ffffff;
    font-size: 13px;
}

#modelName {
    font-weight: 700;
    color: #ffffff;
    font-size: 14px;
}

#modelBadge {
    background-color: rgba(201, 150, 42, 0.16);
    color: #F0C84A;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---------------------------------------------------------------------------
   Tablas y listas
--------------------------------------------------------------------------- */

QTableWidget {
    background-color: #1A1A1A;
    alternate-background-color: #2E2E2E;
    gridline-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    padding: 2px;
}

QTableWidget::item {
    padding: 6px 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

QTableWidget::item:selected {
    background-color: rgba(201, 150, 42, 0.16);
    color: #ffffff;
}

QHeaderView::section {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1A1210, stop:1 #0C0806);
    color: #ffffff;
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 6px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

QTableCornerButton::section {
    background-color: #1A1210;
    border: none;
}

QListWidget {
    background-color: #1A1A1A;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    padding: 4px;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.82);
}

QListWidget::item:selected {
    background-color: rgba(201, 150, 42, 0.16);
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #202020;
}

/* ---------------------------------------------------------------------------
   Barras de progreso
--------------------------------------------------------------------------- */

QProgressBar {
    background-color: #2E2E2E;
    border: none;
    border-radius: 5px;
    text-align: center;
    height: 10px;
    max-height: 10px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 10px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #E0AC35, stop:1 #C9962A);
    border-radius: 5px;
}

/* ---------------------------------------------------------------------------
   Campos de entrada
--------------------------------------------------------------------------- */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1A1A1A;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 6px 9px;
    selection-background-color: #8C6518;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: rgba(255, 255, 255, 0.18);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #C9962A;
}

QLineEdit:disabled {
    color: rgba(255, 255, 255, 0.3);
    background-color: #141414;
}

QComboBox {
    background-color: #1A1A1A;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: rgba(255, 255, 255, 0.18);
}

QComboBox:focus, QComboBox:on {
    border-color: #C9962A;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255, 255, 255, 0.5);
    margin-right: 2px;
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: rgba(201, 150, 42, 0.22);
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 5px;
    min-height: 20px;
}

/* ---------------------------------------------------------------------------
   Slider (Preferencias → límite de paralelismo)
--------------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #2E2E2E;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #C9962A;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #ffffff;
    border: 2px solid #C9962A;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    border-color: #F0C84A;
}

/* ---------------------------------------------------------------------------
   Diálogos / botones estándar
--------------------------------------------------------------------------- */

QDialogButtonBox {
    padding-top: 6px;
}

QMessageBox {
    background-color: #141414;
}

QMessageBox QLabel {
    color: rgba(255, 255, 255, 0.85);
}

/* ---------------------------------------------------------------------------
   Splitter
--------------------------------------------------------------------------- */

QSplitter::handle {
    background-color: rgba(255, 255, 255, 0.07);
}

QSplitter::handle:hover {
    background-color: #C9962A;
}

/* ---------------------------------------------------------------------------
   Scrollbars (macOS-like, delgadas, neutras)
--------------------------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.26);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.26);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
