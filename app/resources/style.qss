/* ============================================================================
   Voz a Texto — sistema visual
   ----------------------------------------------------------------------------
   Paleta (referencia; QSS no soporta variables, se deja documentado aquí):

   Fondo app ......... #0c0d10   Texto primario ..... #f5f6f8
   Fondo sidebar ...... #111217   Texto secundario .... #9aa0ac
   Fondo contenido .... #15161b   Texto terciario ..... #5f636d
   Fondo tarjeta ...... #1b1c22
   Fondo tarjeta hover  #212229   Acento (azul) ....... #3b82f6
   Borde sutil ........ #26272e   Acento hover ........ #559bfb
   Borde medio ........ #34353e   Acento pressed ...... #2f6fe0
   Borde foco ......... #3b82f6   Peligro ............. #f16565
                                   Éxito ............... #34d399
   ========================================================================= */

* {
    outline: none;
}

QWidget {
    color: #f5f6f8;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #15161b;
}

/* QLabel no debe pintar su propio fondo: si un QWidget contenedor define un
   color (tarjeta, sidebar, etc.), las etiquetas hijas deben dejarlo transparentar. */
QLabel {
    background: transparent;
}

QToolTip {
    background-color: #24252c;
    color: #f5f6f8;
    border: 1px solid #34353e;
    border-radius: 6px;
    padding: 6px 8px;
}

QMenuBar {
    background-color: #15161b;
    color: #f5f6f8;
}

QMenu {
    background-color: #1b1c22;
    border: 1px solid #2b2c34;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    margin: 1px;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}

/* ---------------------------------------------------------------------------
   Tipografía / labels utilitarios
--------------------------------------------------------------------------- */

#panelTitle {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.2px;
}

#panelKicker {
    font-size: 11px;
    font-weight: 700;
    color: #559bfb;
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

#sectionTitle {
    font-size: 12px;
    font-weight: 700;
    color: #9aa0ac;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

#hintLabel {
    color: #6f7480;
    font-size: 11.5px;
}

#errorLabel {
    color: #f16565;
    font-size: 11.5px;
}

/* ---------------------------------------------------------------------------
   Sidebar de navegación
--------------------------------------------------------------------------- */

#sidebar {
    background-color: #111217;
    border-right: 1px solid #212228;
}

#brandHeader {
    background-color: #111217;
    border-bottom: 1px solid #212228;
}

#brandTitle {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.1px;
}

#brandSubtitle {
    font-size: 10.5px;
    color: #5f636d;
    letter-spacing: 0.3px;
}

QListWidget#sidebarList {
    background-color: transparent;
    border: none;
    padding: 10px 10px;
    outline: none;
    font-size: 13px;
}

QListWidget#sidebarList::item {
    padding: 9px 12px;
    margin-bottom: 2px;
    border-radius: 7px;
    color: #a7acb6;
    border-left: 3px solid transparent;
}

QListWidget#sidebarList::item:selected {
    background-color: rgba(59, 130, 246, 0.16);
    color: #ffffff;
    font-weight: 600;
    border-left: 3px solid #3b82f6;
}

QListWidget#sidebarList::item:hover:!selected {
    background-color: #1a1b21;
    color: #e4e6ea;
}

/* ---------------------------------------------------------------------------
   Botones
--------------------------------------------------------------------------- */

QPushButton {
    background-color: #22232b;
    border: 1px solid #34353e;
    border-radius: 7px;
    padding: 7px 15px;
    color: #f0f1f3;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #292a33;
    border-color: #3e4049;
}

QPushButton:pressed {
    background-color: #1c1d24;
}

QPushButton:disabled {
    color: #52555f;
    background-color: #1a1b20;
    border-color: #26272e;
}

QPushButton:focus {
    border-color: #3b82f6;
}

/* Botón por defecto de un QDialogButtonBox (p.ej. Aceptar) y botones marcados
   explícitamente como primarios: acento sólido, para la acción principal. */
QPushButton:default,
QPushButton[variant="primary"] {
    background-color: #3b82f6;
    border: 1px solid #3b82f6;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover,
QPushButton[variant="primary"]:hover {
    background-color: #559bfb;
    border-color: #559bfb;
}

QPushButton:default:pressed,
QPushButton[variant="primary"]:pressed {
    background-color: #2f6fe0;
    border-color: #2f6fe0;
}

QPushButton[variant="danger"] {
    background-color: transparent;
    border: 1px solid #4a2c2c;
    color: #f16565;
}

QPushButton[variant="danger"]:hover {
    background-color: rgba(241, 101, 101, 0.12);
    border-color: #f16565;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: #9aa0ac;
    padding: 5px 10px;
}

QPushButton[variant="ghost"]:hover {
    background-color: #1e1f26;
    color: #f0f1f3;
}

/* Botones insertados como cell widget en QTableWidget: necesitan fondo opaco.
   Un fondo transparente ahí produce artefactos de repintado con Qt al reciclar
   los widgets de celda (se ve texto fantasma/duplicado). */
QPushButton[variant="tableAction"] {
    background-color: #24252c;
    border: 1px solid #34353e;
    color: #d5d7db;
    padding: 4px 12px;
    font-size: 12px;
}

QPushButton[variant="tableAction"]:hover {
    background-color: #2c2d35;
    border-color: #45474f;
}

/* ---------------------------------------------------------------------------
   Tarjetas (stat tiles, worker cards, filas de modelo)
--------------------------------------------------------------------------- */

#statTile, #workerCard, #modelRow {
    background-color: #1b1c22;
    border: 1px solid #26272e;
    border-radius: 12px;
}

#workerCard {
    border-left: 3px solid #3b82f6;
}

#chartCard {
    border: 1px solid #26272e;
    border-radius: 10px;
}

#statValue {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.3px;
}

#statTitle {
    color: #6f7480;
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

#workerCardTitle {
    font-weight: 700;
    color: #ffffff;
    font-size: 13px;
}

#modelName {
    font-weight: 700;
    color: #ffffff;
    font-size: 14px;
}

#modelBadge {
    background-color: rgba(52, 211, 153, 0.14);
    color: #34d399;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---------------------------------------------------------------------------
   Tablas y listas
--------------------------------------------------------------------------- */

QTableWidget {
    background-color: #17181d;
    alternate-background-color: #1a1b21;
    gridline-color: transparent;
    border: 1px solid #26272e;
    border-radius: 10px;
    padding: 2px;
}

QTableWidget::item {
    padding: 6px 4px;
    border-bottom: 1px solid #202127;
}

QTableWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.16);
    color: #ffffff;
}

QHeaderView::section {
    background-color: #17181d;
    color: #6f7480;
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 6px;
    border: none;
    border-bottom: 1px solid #26272e;
}

QTableCornerButton::section {
    background-color: #17181d;
    border: none;
}

QListWidget {
    background-color: #17181d;
    border: 1px solid #26272e;
    border-radius: 10px;
    padding: 4px;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: #e4e6ea;
}

QListWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.16);
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #1e1f26;
}

/* ---------------------------------------------------------------------------
   Barras de progreso
--------------------------------------------------------------------------- */

QProgressBar {
    background-color: #202127;
    border: none;
    border-radius: 5px;
    text-align: center;
    height: 10px;
    max-height: 10px;
    color: #d5d7db;
    font-size: 10px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3b82f6, stop:1 #4fb8f0);
    border-radius: 5px;
}

/* ---------------------------------------------------------------------------
   Campos de entrada
--------------------------------------------------------------------------- */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1b1c22;
    border: 1px solid #2b2c34;
    border-radius: 7px;
    padding: 6px 9px;
    selection-background-color: #3b82f6;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: #383a44;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #3b82f6;
}

QLineEdit:disabled {
    color: #5f636d;
    background-color: #17181d;
}

QComboBox {
    background-color: #1b1c22;
    border: 1px solid #2b2c34;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #383a44;
}

QComboBox:focus, QComboBox:on {
    border-color: #3b82f6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9aa0ac;
    margin-right: 2px;
}

QComboBox QAbstractItemView {
    background-color: #1e1f26;
    border: 1px solid #2f313b;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 5px;
    min-height: 20px;
}

/* ---------------------------------------------------------------------------
   Slider (Preferencias → límite de paralelismo)
--------------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #2b2c34;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #3b82f6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #ffffff;
    border: 2px solid #3b82f6;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    border-color: #559bfb;
}

/* ---------------------------------------------------------------------------
   Diálogos / botones estándar
--------------------------------------------------------------------------- */

QDialogButtonBox {
    padding-top: 6px;
}

QMessageBox {
    background-color: #17181d;
}

QMessageBox QLabel {
    color: #f5f6f8;
}

/* ---------------------------------------------------------------------------
   Splitter
--------------------------------------------------------------------------- */

QSplitter::handle {
    background-color: #212228;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}

/* ---------------------------------------------------------------------------
   Scrollbars (macOS-like, delgadas)
--------------------------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #34353e;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #45474f;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #34353e;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #45474f;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
