/* ============================================================================
   Voz a Texto — sistema visual
   ----------------------------------------------------------------------------
   Réplica del lenguaje visual del frontend de Farmora (Imperioon), preset
   "azul_clinico" (src/theme/presets.js): claro, limpio, tarjetas blancas con
   sombra suave, acento azul. QSS no soporta variables CSS, documentado:

   Fondo de página ...... #F8FAFC   Texto principal ....... #0F172A
   Superficie (tarjetas)   #FFFFFF   Texto secundario ...... #64748B
   Borde ................ #E2E8F0   Texto sobre primario .. #FFFFFF

   Primario (marca) ..... #2563EB   Primario claro (hover) . #60A5FA
   Éxito ................ #16A34A   Error .................. #DC2626
   Advertencia .......... #D97706

   Tipografía: Inter (embebida, ver app/main.py:_load_brand_font) — la misma
   que usa el frontend de referencia.
   ========================================================================= */

* {
    outline: none;
}

QWidget {
    color: #0F172A;
    font-family: "Inter", -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: #2563EB;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #F8FAFC;
}

QLabel {
    background: transparent;
}

QToolTip {
    background-color: #0F172A;
    color: #ffffff;
    border: 1px solid #0F172A;
    border-radius: 6px;
    padding: 6px 8px;
}

QMenuBar {
    background-color: #F8FAFC;
    color: #0F172A;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    margin: 1px;
    color: #0F172A;
}

QMenu::item:selected {
    background-color: rgba(37, 99, 235, 0.12);
    color: #1D4ED8;
}

/* ---------------------------------------------------------------------------
   Tipografía / labels utilitarios
--------------------------------------------------------------------------- */

#panelTitle {
    font-size: 22px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.2px;
}

#panelKicker {
    font-size: 11px;
    font-weight: 600;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#sectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
}

#hintLabel {
    color: #64748B;
    font-size: 12px;
}

#errorLabel {
    color: #DC2626;
    font-size: 11.5px;
    font-weight: 600;
}

/* ---------------------------------------------------------------------------
   Sidebar de navegación
--------------------------------------------------------------------------- */

#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #E2E8F0;
}

#brandHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #E2E8F0;
}

#brandTitle {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
}

#brandSubtitle {
    font-size: 10.5px;
    color: #9CA3AF;
    letter-spacing: 0.2px;
}

QListWidget#sidebarList {
    background-color: transparent;
    border: none;
    padding: 10px 10px;
    outline: none;
    font-size: 13px;
}

QListWidget#sidebarList::item {
    padding: 9px 12px;
    margin-bottom: 2px;
    border-radius: 8px;
    color: #64748B;
}

QListWidget#sidebarList::item:selected {
    background-color: rgba(37, 99, 235, 0.12);
    color: #1D4ED8;
    font-weight: 600;
}

QListWidget#sidebarList::item:hover:!selected {
    background-color: #F8FAFC;
    color: #0F172A;
}

/* ---------------------------------------------------------------------------
   Botones
--------------------------------------------------------------------------- */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 7px 15px;
    color: #374151;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #D1D5DB;
}

QPushButton:pressed {
    background-color: #F3F4F6;
}

QPushButton:disabled {
    color: #9CA3AF;
    background-color: #F3F4F6;
    border-color: #E2E8F0;
}

QPushButton:focus {
    border-color: #2563EB;
}

/* Botón por defecto de un QDialogButtonBox (p.ej. Guardar) y botones marcados
   explícitamente como primarios: azul sólido de marca. */
QPushButton:default,
QPushButton[variant="primary"] {
    background-color: #2563EB;
    border: 1px solid #2563EB;
    color: #ffffff;
    font-weight: 700;
}

QPushButton:default:hover,
QPushButton[variant="primary"]:hover {
    background-color: #60A5FA;
    border-color: #60A5FA;
}

QPushButton:default:pressed,
QPushButton[variant="primary"]:pressed {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton[variant="danger"] {
    background-color: transparent;
    border: 1px solid #FCA5A5;
    color: #DC2626;
}

QPushButton[variant="danger"]:hover {
    background-color: rgba(220, 38, 38, 0.08);
    border-color: #DC2626;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: #64748B;
    padding: 5px 10px;
}

QPushButton[variant="ghost"]:hover {
    background-color: #F3F4F6;
    color: #0F172A;
}

/* Botones insertados como cell widget en QTableWidget: necesitan fondo opaco.
   Un fondo transparente ahí produce artefactos de repintado con Qt al reciclar
   los widgets de celda (se ve texto fantasma/duplicado). */
QPushButton[variant="tableAction"] {
    background-color: #F3F4F6;
    border: 1px solid #E2E8F0;
    color: #374151;
    padding: 4px 12px;
    font-size: 12px;
}

QPushButton[variant="tableAction"]:hover {
    background-color: #E2E8F0;
    border-color: #D1D5DB;
}

/* ---------------------------------------------------------------------------
   Tarjetas (stat tiles, worker cards, filas de modelo)
--------------------------------------------------------------------------- */

#statTile, #workerCard, #modelRow {
    background-color: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

#workerCard {
    border-left: 3px solid #2563EB;
}

#chartCard {
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

#statValue {
    font-size: 26px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.3px;
}

#statTitle {
    color: #64748B;
    font-size: 12.5px;
    font-weight: 500;
}

#workerCardTitle {
    font-weight: 700;
    color: #0F172A;
    font-size: 13px;
}

#modelName {
    font-weight: 700;
    color: #0F172A;
    font-size: 14px;
}

#modelBadge {
    background-color: rgba(22, 163, 74, 0.10);
    color: #16A34A;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---------------------------------------------------------------------------
   Tablas y listas
--------------------------------------------------------------------------- */

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #F8FAFC;
    gridline-color: transparent;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 2px;
}

QTableWidget::item {
    padding: 6px 4px;
    border-bottom: 1px solid #F3F4F6;
    color: #374151;
}

QTableWidget::item:selected {
    background-color: rgba(37, 99, 235, 0.12);
    color: #0F172A;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 6px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

QTableCornerButton::section {
    background-color: #F8FAFC;
    border: none;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 4px;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: #374151;
}

QListWidget::item:selected {
    background-color: rgba(37, 99, 235, 0.12);
    color: #0F172A;
}

QListWidget::item:hover:!selected {
    background-color: #F8FAFC;
}

/* ---------------------------------------------------------------------------
   Barras de progreso
--------------------------------------------------------------------------- */

QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 5px;
    text-align: center;
    height: 10px;
    max-height: 10px;
    color: #0F172A;
    font-size: 10px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 5px;
}

/* ---------------------------------------------------------------------------
   Campos de entrada
--------------------------------------------------------------------------- */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px 9px;
    selection-background-color: #2563EB;
    color: #0F172A;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: #D1D5DB;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #2563EB;
}

QLineEdit:disabled {
    color: #9CA3AF;
    background-color: #F3F4F6;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 18px;
    color: #0F172A;
}

QComboBox:hover {
    border-color: #D1D5DB;
}

QComboBox:focus, QComboBox:on {
    border-color: #2563EB;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748B;
    margin-right: 2px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: rgba(37, 99, 235, 0.14);
    selection-color: #0F172A;
    color: #0F172A;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 5px;
    min-height: 20px;
}

/* ---------------------------------------------------------------------------
   Slider (Preferencias → límite de paralelismo)
--------------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #E2E8F0;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #2563EB;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #ffffff;
    border: 2px solid #2563EB;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    border-color: #1D4ED8;
}

/* ---------------------------------------------------------------------------
   Diálogos / botones estándar
--------------------------------------------------------------------------- */

QDialogButtonBox {
    padding-top: 6px;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #0F172A;
}

/* ---------------------------------------------------------------------------
   Splitter
--------------------------------------------------------------------------- */

QSplitter::handle {
    background-color: #E2E8F0;
}

QSplitter::handle:hover {
    background-color: #2563EB;
}

/* ---------------------------------------------------------------------------
   Scrollbars (macOS-like, delgadas)
--------------------------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
